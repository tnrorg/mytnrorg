# Installers and large binaries must never enter the repo — GitHub rejects
# anything over 100 MB, and the rejection blocks the whole push.
*.exe
*.msi
*.dmg
*.zip
*.7z
*.iso

# Scratch copies made while testing a module in isolation. They are duplicates
# of a real file in lib/, so committing one means two versions of the same
# logic and no way to tell which is live.
*.test.mjs

.vercel
.env*
