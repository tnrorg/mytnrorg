# ─── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=tnr-media

# ─── Admin / security ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ─── Phone / OTP ──────────────────────────────────────────────────────────
DEFAULT_COUNTRY_CODE=92
# OTP delivery: "whatsapp" (free self-hosted) | "twilio" | "dev"
OTP_PROVIDER=email
WHATSAPP_SERVICE_URL=http://localhost:4000
WA_API_KEY=change_this_key

# ─── Twilio (only if OTP_PROVIDER=twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_SMS_FROM=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Tehreek-e-Nojawanan Roundu
NEXT_PUBLIC_APP_SHORT=TNR
NEXT_PUBLIC_ELECTION_YEAR=2026

# ─── Meta WhatsApp Cloud API (OTP)  —  set OTP_PROVIDER=meta to use ─────────
# From Meta ▸ WhatsApp ▸ API Setup / Business Settings. Server-side only.
META_WA_TOKEN=EAAG...your-permanent-access-token
META_WA_PHONE_NUMBER_ID=1234567890
META_WA_BUSINESS_ACCOUNT_ID=1234567890
META_WA_API_VERSION=v21.0
# Your APPROVED template name + language + whether it has the copy-code button
META_WA_TEMPLATE_NAME=otp_verification
META_WA_TEMPLATE_LANG=en
META_WA_TEMPLATE_HAS_BUTTON=true

# ─── Email OTP (SMTP) — set OTP_PROVIDER=email to use ──────────────────────
# Free with a Gmail App Password, Brevo, SendGrid SMTP, etc. Server-side only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Tehreek-e-Nojawanan Roundu <your@gmail.com>
